# Live Home Assistant API checks. Keep real values only in the ignored .env.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_ACCESS_TOKEN=

# Installing a custom integration also requires a file-deployment route to
# Home Assistant's config/custom_components directory. P00-T04 audited these
# contracts; P01-T10 must select exactly one before deployment. Do not add
# passwords to this file.
# WCA_HOME_ASSISTANT_CONFIG_PATH=
# WCA_HOME_ASSISTANT_SSH_HOST=
# WCA_HOME_ASSISTANT_SSH_PORT=22
# WCA_HOME_ASSISTANT_SSH_USER=
# WCA_HOME_ASSISTANT_SSH_KEY_PATH=
